package dev.cajeta.docs;

/**
 * Node kinds of the logical tree (spec §2.1) and element sub-kinds
 * (§3). Plain int32 codes — they index arena arrays.
 */
public final class NodeKind {

    public static int32 DOCUMENT()   { return 0; }
    public static int32 SECTION()    { return 1; }
    public static int32 PARAGRAPH()  { return 2; }
    public static int32 SENTENCE()   { return 3; }
    public static int32 LIST()       { return 4; }
    public static int32 LIST_ITEM()  { return 5; }
    public static int32 TABLE()      { return 6; }
    public static int32 CODE_BLOCK() { return 7; }
    public static int32 ELEMENT()    { return 8; }

    /** Element sub-kinds (§3.1–§3.6). */
    public static int32 IMAGE()      { return 0; }
    public static int32 CHART()      { return 1; }
    public static int32 EQUATION()   { return 2; }
    public static int32 FOOTNOTE()   { return 3; }
    public static int32 UNKNOWN()    { return 4; }
}
