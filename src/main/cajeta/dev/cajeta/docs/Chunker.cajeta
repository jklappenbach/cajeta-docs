package dev.cajeta.docs;

import cajeta.collection.ArrayList;
import cajeta.lang.Int64;
import cajeta.lang.String;
import cajeta.lang.StringBuilder;

/**
 * Chunking as SELECTION over the document model (spec §10.1 — never a
 * re-parse): strategies `"paragraph"`, `"sentence"`, `"section"`,
 * `"fixed"`, `"structure"`. The atoms are the model's leaf blocks
 * (paragraphs, list items, tables, code blocks); tables and code
 * blocks are INDIVISIBLE and are never split by any strategy (§10.2,
 * §13.8).
 *
 * - `"structure"` packs atoms up to `maxChars`, never crossing a
 *   section boundary; `"fixed"` packs without the section preference.
 * - `overlap`: adjacent chunks share the previous chunk's tail atoms
 *   up to that many chars, so a fact spanning a boundary survives in
 *   at least one chunk (§10.3).
 * - `headingPath`: prepend the section path so an isolated chunk stays
 *   interpretable (§10.5).
 * - An INDIVISIBLE atom larger than `maxChars` follows the EXPLICIT
 *   `oversize` policy (§10.6): `"emit"` (default — whole, flagged) or,
 *   for divisible paragraphs only, `"split"` with a `[...]` marker.
 *   Tables and code are ALWAYS emitted whole.
 *
 * Same document + same settings → identical chunks (§10.7).
 */
public final class Chunker {

    String strategy;
    int64 maxChars;
    int64 overlap;
    boolean headingPath;
    String oversize;

    public Chunker() {
        this.strategy = "structure";
        this.maxChars = 512;
        this.overlap = 0;
        this.headingPath = false;
        this.oversize = "emit";
        return;
    }

    public void setStrategy(String s) {
        if (!s.equals("paragraph") && !s.equals("sentence")
            && !s.equals("section") && !s.equals("fixed")
            && !s.equals("structure")) {
            throw heap DocsException("Chunker: unknown strategy \"" + s
                + "\"");
        }
        this.strategy = "" + s;
        return;
    }

    public void setMaxChars(int64 n) {
        if (n < 1) {
            throw heap DocsException("Chunker: maxChars must be >= 1");
        }
        this.maxChars = n;
        return;
    }

    public void setOverlap(int64 n) {
        if (n < 0) {
            throw heap DocsException("Chunker: overlap must be >= 0");
        }
        this.overlap = n;
        return;
    }

    public void setHeadingPath(boolean on) {
        this.headingPath = on;
        return;
    }

    /** Oversize policy (§10.6): "emit" or "split". */
    public void setOversize(String p) {
        if (!p.equals("emit") && !p.equals("split")) {
            throw heap DocsException("Chunker: oversize must be "
                + "\"emit\" or \"split\"");
        }
        this.oversize = "" + p;
        return;
    }

    /** Chunk the document under the configured strategy. */
    public #ChunkList chunk(Doc d) {
        // The atoms: leaf blocks in document order.
        ArrayList<Int64> atoms = heap ArrayList<Int64>();
        int64 n = d.nodeCount();
        int64 nid = 0;
        while (nid < n) {
            int32 k = d.kindOf(nid);
            if (k == 2 || k == 5 || k == 6 || k == 7) {
                if (d.charEnd(nid) > d.charStart(nid)) {
                    atoms.add(Int64.of(nid));
                }
            }
            nid = nid + 1;
        }
        Out out = heap Out();
        if (this.strategy.equals("paragraph")) {
            int32 a = 0;
            while (a < atoms.count()) {
                int64 id = atoms.get(a).value();
                this.emit(out, d, id, id, false);
                a = a + 1;
            }
        } else if (this.strategy.equals("section")) {
            int64[] secs = d.nodesOfKind((int32) 1);
            int64 s = 0;
            while (s < (int64) secs.count()) {
                this.emitRange(out, d, d.charStart(secs[s]),
                    d.charEnd(secs[s]), d.sectionPath(secs[s]), false);
                s = s + 1;
            }
        } else if (this.strategy.equals("sentence")) {
            Segmenter g = heap Segmenter();
            int32 a = 0;
            while (a < atoms.count()) {
                int64 id = atoms.get(a).value();
                int32 kk = d.kindOf(id);
                if (kk == 6 || kk == 7) {
                    this.emit(out, d, id, id, false);   // atomic
                } else {
                    String text = d.text(id);
                    SentenceList sl = g.segment(text);
                    int64 base = d.charStart(id);
                    int64 si = 0;
                    while (si < sl.count()) {
                        this.emitRange(out, d, base + sl.startOf(si),
                            base + sl.endOf(si), d.sectionPath(id),
                            false);
                        si = si + 1;
                    }
                }
                a = a + 1;
            }
        } else {
            // fixed | structure: greedy packing over atoms.
            boolean bySection = this.strategy.equals("structure");
            int32 a = 0;
            while (a < atoms.count()) {
                int64 firstA = atoms.get(a).value();
                String curPath = d.sectionPath(firstA);
                int64 size = 0;
                int32 startIx = a;
                while (a < atoms.count()) {
                    int64 id = atoms.get(a).value();
                    int64 len = d.charEnd(id) - d.charStart(id);
                    boolean sameSec = true;
                    if (bySection) {
                        sameSec = d.sectionPath(id).equals(curPath);
                    }
                    if (a == startIx) {
                        // First atom always joins; oversize handled at
                        // emit.
                        size = len;
                        a = a + 1;
                    } else if (sameSec && size + len <= this.maxChars) {
                        size = size + len;
                        a = a + 1;
                    } else {
                        break;
                    }
                }
                int64 lastA = atoms.get(a - 1).value();
                boolean over = size > this.maxChars;
                if (over && this.oversize.equals("split")
                    && startIx == a - 1
                    && d.kindOf(firstA) == 2) {
                    // A divisible paragraph: split at maxChars with a
                    // marker. Tables/code NEVER take this path.
                    this.emitSplit(out, d, firstA);
                } else {
                    this.emit(out, d, firstA, lastA, over);
                }
                // Overlap: step back so the tail atoms reappear.
                if (this.overlap > 0 && a < atoms.count()) {
                    int64 back = 0;
                    int32 b = a - 1;
                    while (b > startIx) {
                        int64 id = atoms.get(b).value();
                        int64 len = d.charEnd(id) - d.charStart(id);
                        if (back + len > this.overlap) { break; }
                        back = back + len;
                        b = b - 1;
                    }
                    if (b + 1 < a && (int64) (b + 1) > (int64) startIx) {
                        a = b + 1;
                    }
                }
            }
        }
        return out.seal(d);
    }

    void emit(Out out, Doc d, int64 firstA, int64 lastA, boolean over) {
        this.emitRange(out, d, d.charStart(firstA), d.charEnd(lastA),
            d.sectionPath(firstA), over);
        return;
    }

    void emitRange(Out out, Doc d, int64 lo, int64 hi, String path,
                   boolean over) {
        String body = d.fullText().substring((int32) lo, (int32) hi);
        String text = body;
        if (this.headingPath && path.count() > 0) {
            text = path + "\n" + body;
        }
        out.add(text, lo, hi, path, over);
        return;
    }

    void emitSplit(Out out, Doc d, int64 nid) {
        int64 lo = d.charStart(nid);
        int64 hi = d.charEnd(nid);
        String path = d.sectionPath(nid);
        int64 cur = lo;
        while (cur < hi) {
            int64 end = cur + this.maxChars;
            if (end > hi) { end = hi; }
            String body = d.fullText().substring((int32) cur, (int32) end);
            String text = body;
            if (end < hi) { text = text + " [...]"; }
            if (cur > lo) { text = "[...] " + text; }
            if (this.headingPath && path.count() > 0) {
                text = path + "\n" + text;
            }
            out.add(text, cur, end, path, false);
            cur = end;
        }
        return;
    }
}
