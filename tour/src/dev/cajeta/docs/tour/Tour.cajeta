package dev.cajeta.docs.tour;

import dev.cajeta.docs.Doc;
import dev.cajeta.docs.DocBuilder;
import dev.cajeta.docs.NodeKind;
import dev.cajeta.docs.Provenance;

/**
 * The self-checking tour of dev.cajeta.docs. Every passage demonstrates
 * a documented claim and CHECKS it — a non-zero exit means the docs
 * lied. Passages land unit by unit alongside the library.
 */
public final class Tour {

    static int32 failures;

    static void check(boolean ok, String what) {
        if (ok) {
            System.stdout.println("  ok  - " + what);
        } else {
            System.stdout.println("  FAIL- " + what);
            Tour.failures = Tour.failures + 1;
        }
        return;
    }

    /** Passage 1 — one parse, every granularity, full provenance. */
    static void modelPassage() {
        System.stdout.println("passage: the document model");
        DocBuilder b = heap DocBuilder("tour/example.txt");
        b.setPageful();
        int64 s = b.beginSection("Findings");
        int64 p = b.paragraph("The result held under both conditions.");
        b.pageBreak();
        int64 q = b.paragraph("Replication succeeded on page two.");
        b.endSection();
        Doc d = b.build();
        Tour.check(d.parseCount() == (int64) 1,
            "one parse serves every granularity");
        Tour.check((int64) d.nodesOfKind(NodeKind.PARAGRAPH()).count() == (int64) 2,
            "granularity queries scan the arena, never re-parse");
        Provenance pr = d.provenance(q);
        Tour.check(pr.sectionPath.equals("Findings"),
            "every node resolves its section path");
        Tour.check(pr.pages[0] == (int64) 2,
            "the physical view knows which page a node is on");
        int64[] docPages = d.pagesOf((int64) 0);
        Tour.check((int64) docPages.count() == (int64) 2,
            "a node spanning the break lists BOTH pages");
        return;
    }

    public static int32 main() {
        Tour.failures = 0;
        System.stdout.println("== dev.cajeta.docs tour ==");
        Tour.modelPassage();
        if (Tour.failures > 0) {
            System.stdout.println("TOUR FAILED: " + Tour.failures + " check(s)");
            return 1;
        }
        System.stdout.println("tour complete: all checks passed");
        return 0;
    }
}
