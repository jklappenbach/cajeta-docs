{
    // cajeta-docs — THE text/document library for the cajeta ecosystem:
    // one parse produces a structured model (document · section ·
    // paragraph · sentence · line · token · element, in a logical tree
    // PLUS an orthogonal physical page/line view), and every consumer
    // selects a granularity from it rather than re-parsing. Readers for
    // text, Markdown, HTML, CSV/JSON (source code, OOXML, and PDF land
    // when their prerequisites — cajeta-codec XML, cajeta-font — exist);
    // normalization, tokenization, sentence segmentation; TF-IDF and
    // count vectorization over CsrMatrix; chunking; BPE/WordPiece.
    //
    // DELIBERATELY NO dev.cajeta.ml DEPENDENCY (spec §12.7): the thin
    // Transformer adapter ships with ml, not here. Document input is
    // untrusted by definition (§4.9) — every reader is fuzzed.
    //
    // A LIBRARY project: no `entry-method`, so the build emits a reusable
    // `.cja` rather than an executable.
    //
    // VERSIONING — `details.version` is the SINGLE source of truth. It names
    // the built archive (`dev.cajeta.docs-<version>.cja`), it is what CI
    // publishes to Olla, and CI asserts a `v*` tag agrees with it.

    "details": {
        "name":               "dev.cajeta.docs",
        "version":            "0.1.0",
        "description":        "cajeta-docs — the text/document library: structured document model, format readers, tokenization, TF-IDF, chunking",
        "license":            "Apache-2.0",
        "authors":            ["Julian Klappenbach"],
        "cajeta-lang-version": "1.0"
    },

    "settings": {
        // Readers open files handed to them by path.
        "capabilities": ["filesystem"],

        // Stdlib only — codec (CSV/JSON), collection, nucleo.frame,
        // nucleo.sparse, lang.String normalization. NO dev.cajeta.ml.
        "dependencies": {},

        "dev-dependencies": {
            "dev.cajeta.unit": "0.2.0"
        },

        "repositories": [
            { "name": "central", "url": "https://olla.cajeta.dev",
              "priority": 0 }
        ],

        "build": {
            "source-root": "src/main/cajeta",
            "target": "host"
        }
    },

    "tasks": {

        "build": {
            "description": "Compile sources to a .cja library archive",
            "actions": [
                { "action": "build", "flavor": "debug", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "test": {
            "description": "Build + run the library's test suite",
            "actions": [
                { "action": "exec", "command": "./run-tests.sh" }
            ]
        },

        "tour": {
            "description": "Build + run the self-checking tour",
            "actions": [
                { "action": "exec", "command": "./run-tour.sh" }
            ]
        },

        "release": {
            "description": "Release build of the .cja",
            "actions": [
                { "action": "build", "flavor": "release", "id": "art" }
            ],
            "outputs": { "path": "${art.path}", "sha256": "${art.sha256}" }
        },

        "clean": {
            "description": "Remove build outputs",
            "actions": [
                { "action": "exec", "command": "rm -rf build" }
            ]
        }
    }
}
